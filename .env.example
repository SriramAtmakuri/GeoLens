# ── LLM provider ──────────────────────────────────────────────────────────────
# Set ONE of these. Groq is free: https://console.groq.com
GROQ_API_KEY=
OPENAI_API_KEY=

# Optional: Mapbox token (only needed if you swap Leaflet for Mapbox GL JS)
# MAPBOX_TOKEN=pk.eyJ1...

# These match the docker-compose defaults — change only if you override the DB
# DATABASE_URL=postgresql://geolens:geolens@db:5432/geolens
# REDIS_URL=redis://redis:6379
